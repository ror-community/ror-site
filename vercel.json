{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "images": {
    "sizes": [320, 640, 960, 1280, 1920, 2560],
    "qualities": [75],
    "formats": ["image/avif", "image/webp"],
    "localPatterns": [{ "pathname": "^/img/.*$", "search": "" }]
  },
  "rewrites": [
    {
      "source": "/img/:path*",
      "has": [{ "type": "query", "key": "w", "value": "(?<width>\\d+)" }],
      "destination": "/_vercel/image?url=/img/:path*&w=:width&q=75"
    }
  ]
}
